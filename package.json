{
  "name": "autodeck",
  "version": "1.0.5",
  "description": "AutoDeck — запускай сценарии программ одной кнопкой",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:main": "tsc -p tsconfig.node.json --noEmit",
    "test": "node --test tests/*.test.cjs",
    "build:win": "npm run build && npm run build:main && electron-builder --win",
    "build:win:x64": "npm run build && npm run build:main && electron-builder --win --x64 --config.directories.output=Installer/x64 --config.nsis.differentialPackage=false",
    "build:win:arm64": "npm run build && npm run build:main && electron-builder --win --arm64 --config.directories.output=Installer/arm64 --config.nsis.differentialPackage=false",
    "preview": "vite preview"
  },
  "dependencies": {
    "nanoid": "^5.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^44.4.1",
    "electron-builder": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  },
  "build": {
    "appId": "com.autodeck.app",
    "productName": "AutoDeck",
    "directories": {
      "output": "release"
    },
    "icon": "build/autodeck-icon.ico",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/autodeck-icon.png",
        "to": "autodeck-icon.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    }
  },
  "allowScripts": {
    "electron@44.4.1": true,
    "esbuild@0.25.12": true
  }
}
